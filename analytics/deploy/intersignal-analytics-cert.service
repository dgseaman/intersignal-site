[Unit]
Description=Issue or renew the Intersignal stats TLS certificate
Wants=network-online.target
After=network-online.target haproxy.service
Requires=haproxy.service

[Service]
Type=oneshot
EnvironmentFile=/etc/intersignal-analytics/acme.env
UMask=0077
ExecStart=/usr/local/sbin/intersignal-analytics-cert
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/intersignal-analytics-acme/production
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
