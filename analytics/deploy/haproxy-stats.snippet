# Add inside the existing :443 TCP frontend, after the relay SNI routes:
    use_backend intersignal_analytics_tls if { req.ssl_sni -i stats.relay.intersignal.org }

# Add as a new backend. send-proxy supplies the actual visitor IP to nginx.
backend intersignal_analytics_tls
    mode tcp
    server analytics 127.0.0.1:8443 send-proxy check
